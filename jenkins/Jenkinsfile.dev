pipeline {
  agent any

  environment {
    APP_IMAGE = "ghcr.io/ghidinipanaro-prog/devoops"
    IMAGE_TAG = "dev-${BUILD_NUMBER}"
    K8S_NS    = "dev"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Tests') {
      steps {
        sh '''
          cid=$(docker create python:3.12-slim sh -c "pip install --quiet -r /w/app/requirements.txt pytest && cd /w && pytest tests/")
          docker cp ./. "$cid":/w
          rc=0
          docker start -a "$cid" || rc=$?
          docker rm "$cid" > /dev/null
          exit $rc
        '''
      }
    }

    stage('Build & Load to kind') {
      steps {
        sh """
          docker build -t ${APP_IMAGE}:${IMAGE_TAG} ./app
          docker save ${APP_IMAGE}:${IMAGE_TAG} | docker exec -i devoops-control-plane ctr -n k8s.io images import -
        """
      }
    }

    stage('Deploy DEV') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig-kind', variable: 'KUBECONFIG')]) {
          sh """
            kubectl create namespace ${K8S_NS} --dry-run=client -o yaml | kubectl apply -f -
            kubectl apply -k k8s/overlays/${K8S_NS}
            kubectl set image deployment/devoops devoops=${APP_IMAGE}:${IMAGE_TAG} -n ${K8S_NS}
            kubectl rollout status deployment/devoops -n ${K8S_NS} --timeout=120s
          """
        }
      }
    }
  }
}
